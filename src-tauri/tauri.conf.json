{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UYAP Dosya Karsilastirma",
  "version": "../package.json",
  "identifier": "com.uyap.dosya-karsilastirma",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "UYAP Dosya Karşılaştırma",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Sinan Elmas",
    "category": "Productivity",
    "shortDescription": "UYAP dosya karşılaştırma ve analiz aracı",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "tr-TR"
      },
      "nsis": {
        "languages": [
          "Turkish"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEQUFGRDhFRjM4NDUxMEIKUldRTFVZVHpqdjJxL1J3a1FCUks1YkFQUkpYZnVRS1lFZTdaRDlXenZaV3NHYnIxZjA2cDlsNDEK",
      "endpoints": [
        "https://github.com/sinanelms/dosyaKarsilastirma/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
